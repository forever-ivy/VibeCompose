# Documentation only. Do not commit release/production.env or secret values.
OPENWHISPER_CODESIGN_IDENTITY=Developer_ID_Application_certificate_SHA256
OPENWHISPER_TEAM_ID=YOURTEAMID
OPENWHISPER_NOTARY_PROFILE=openwhisper-notary
# Optional when the notary profile is stored in a dedicated release keychain.
OPENWHISPER_NOTARY_KEYCHAIN=/secure/openwhisper-release.keychain-db
# This must be a public HTTPS artifact directory, not the private GitHub repo.
OPENWHISPER_RELEASE_BASE_URL=https://downloads.your-domain.example/openwhisper/v0.1.0
OPENWHISPER_SPARKLE_FEED_URL=https://updates.your-domain.example/stable/appcast.xml
OPENWHISPER_SPARKLE_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
OPENWHISPER_SPARKLE_PRIVATE_KEY_FILE=/secure/openwhisper-sparkle.key
OPENWHISPER_CAPABILITY_POLICY_URL=https://updates.your-domain.example/provider-capabilities.json
OPENWHISPER_CAPABILITY_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
OPENWHISPER_CAPABILITY_PRIVATE_KEY_FILE=/secure/openwhisper-capability.key
OPENWHISPER_CAPABILITY_POLICY_REVISION=1
OPENWHISPER_CAPABILITY_POLICY_EXPIRES_AT=SET_FUTURE_ISO8601
# Optional finalize-only overrides. Defaults are the matching non-example JSON
# names under release/; all four files are ignored by Git.
OPENWHISPER_INSTALLED_ACCEPTANCE_PATH=/secure/release-evidence/installed-acceptance.json
OPENWHISPER_COMMUNITY_PILOT_SUMMARY_PATH=/secure/release-evidence/community-pilot-summary.json
OPENWHISPER_BETA_METRICS_PATH=/secure/release-evidence/beta-metrics.json
OPENWHISPER_PUBLIC_CONTACT_PATH=/secure/release-evidence/public-contact.json
