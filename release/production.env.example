# Documentation only. Do not commit release/production.env or secret values.
VIBEWHISPER_CODESIGN_IDENTITY=Developer_ID_Application_certificate_SHA256
VIBEWHISPER_TEAM_ID=YOURTEAMID
VIBEWHISPER_NOTARY_PROFILE=vibewhisper-notary
# Optional when the notary profile is stored in a dedicated release keychain.
VIBEWHISPER_NOTARY_KEYCHAIN=/secure/vibewhisper-release.keychain-db
# This must be a public HTTPS artifact directory, not the private GitHub repo.
VIBEWHISPER_RELEASE_BASE_URL=https://downloads.your-domain.example/vibewhisper/v0.1.0
VIBEWHISPER_SPARKLE_FEED_URL=https://updates.your-domain.example/stable/appcast.xml
VIBEWHISPER_SPARKLE_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
VIBEWHISPER_SPARKLE_PRIVATE_KEY_FILE=/secure/vibewhisper-sparkle.key
VIBEWHISPER_CAPABILITY_POLICY_URL=https://updates.your-domain.example/provider-capabilities.json
VIBEWHISPER_CAPABILITY_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
VIBEWHISPER_CAPABILITY_PRIVATE_KEY_FILE=/secure/vibewhisper-capability.key
VIBEWHISPER_CAPABILITY_POLICY_REVISION=1
VIBEWHISPER_CAPABILITY_POLICY_EXPIRES_AT=SET_FUTURE_ISO8601
# Optional finalize-only overrides. Defaults are the matching non-example JSON
# names under release/; all four files are ignored by Git.
VIBEWHISPER_INSTALLED_ACCEPTANCE_PATH=/secure/release-evidence/installed-acceptance.json
VIBEWHISPER_COMMUNITY_PILOT_SUMMARY_PATH=/secure/release-evidence/community-pilot-summary.json
VIBEWHISPER_BETA_METRICS_PATH=/secure/release-evidence/beta-metrics.json
VIBEWHISPER_PUBLIC_CONTACT_PATH=/secure/release-evidence/public-contact.json
