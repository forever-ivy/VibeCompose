# Documentation only. Do not commit release/production.env or secret values.
VIBECOMPOSE_CODESIGN_IDENTITY=Developer_ID_Application_certificate_SHA256
VIBECOMPOSE_TEAM_ID=YOURTEAMID
VIBECOMPOSE_NOTARY_PROFILE=vibecompose-notary
# Optional when the notary profile is stored in a dedicated release keychain.
VIBECOMPOSE_NOTARY_KEYCHAIN=/secure/vibecompose-release.keychain-db
# This must be a public HTTPS artifact directory, not the private GitHub repo.
VIBECOMPOSE_RELEASE_BASE_URL=https://downloads.your-domain.example/vibecompose/v0.1.0
VIBECOMPOSE_SPARKLE_FEED_URL=https://updates.your-domain.example/stable/appcast.xml
VIBECOMPOSE_SPARKLE_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
VIBECOMPOSE_SPARKLE_PRIVATE_KEY_FILE=/secure/vibecompose-sparkle.key
VIBECOMPOSE_CAPABILITY_POLICY_URL=https://updates.your-domain.example/provider-capabilities.json
VIBECOMPOSE_CAPABILITY_PUBLIC_ED_KEY=SET_IN_RELEASE_ENVIRONMENT
VIBECOMPOSE_CAPABILITY_PRIVATE_KEY_FILE=/secure/vibecompose-capability.key
VIBECOMPOSE_CAPABILITY_POLICY_REVISION=1
VIBECOMPOSE_CAPABILITY_POLICY_EXPIRES_AT=SET_FUTURE_ISO8601
# Optional finalize-only overrides. Defaults are the matching non-example JSON
# names under release/; all four files are ignored by Git.
VIBECOMPOSE_INSTALLED_ACCEPTANCE_PATH=/secure/release-evidence/installed-acceptance.json
VIBECOMPOSE_COMMUNITY_PILOT_SUMMARY_PATH=/secure/release-evidence/community-pilot-summary.json
VIBECOMPOSE_BETA_METRICS_PATH=/secure/release-evidence/beta-metrics.json
VIBECOMPOSE_PUBLIC_CONTACT_PATH=/secure/release-evidence/public-contact.json
